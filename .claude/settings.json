{
  "enabledPlugins": {
    "loom@private-marketplace": true,
    "skill-creator@claude-plugins-official": true,
    "mentor@private-marketplace": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/skill-creator-gate.sh\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash|Skill",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/instruction-hygiene-gate.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/skill-invoked-mark.sh\" skill-creator skill-creator-gate",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/skill-invoked-mark.sh\" instruction-hygiene instruction-hygiene-gate",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
