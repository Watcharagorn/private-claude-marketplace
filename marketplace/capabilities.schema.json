{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-plugins.org/schemas/private-marketplace/capabilities.schema.json",
  "title": "Dual-host plugin support contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "tier", "hosts", "workflows", "waiver"],
  "properties": {
    "$schema": { "const": "../../marketplace/capabilities.schema.json" },
    "schemaVersion": { "const": 1 },
    "tier": { "enum": ["dual-core", "dual-enhanced", "host-specialized"] },
    "hosts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claude", "codex"],
      "properties": {
        "claude": { "$ref": "#/$defs/host" },
        "codex": { "$ref": "#/$defs/host" }
      }
    },
    "workflows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/workflow" }
    },
    "waiver": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/waiver" }
      ]
    }
  },
  "$defs": {
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "commands", "hooks"],
      "properties": {
        "status": { "enum": ["supported", "partial", "unsupported"] },
        "commands": { "type": "boolean" },
        "hooks": { "type": "boolean" }
      }
    },
    "hostWorkflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "test"],
      "properties": {
        "status": { "enum": ["supported", "partial", "unsupported"] },
        "test": { "type": ["string", "null"] }
      }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "skills", "fallback", "claude", "codex"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "skills": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" }
        },
        "fallback": { "type": "string", "minLength": 1 },
        "claude": { "$ref": "#/$defs/hostWorkflow" },
        "codex": { "$ref": "#/$defs/hostWorkflow" }
      }
    },
    "waiver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "rationale", "missingCapability", "fallback", "reviewBy", "exitCriteria"],
      "properties": {
        "owner": { "type": "string", "minLength": 1 },
        "rationale": { "type": "string", "minLength": 1 },
        "missingCapability": { "type": "string", "minLength": 1 },
        "fallback": { "type": "string", "minLength": 1 },
        "reviewBy": { "type": "string", "format": "date" },
        "exitCriteria": { "type": "string", "minLength": 1 }
      }
    }
  }
}
